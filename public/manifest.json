{
  "manifest_version": 3,
  "name": "Screenshot Stitcher",
  "version": "1.0.0",
  "description": "Capture multiple webpage sections, vertically stitch them, annotate, and export as PNG or PDF.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "downloads"
  ],
  "commands": {
    "capture-viewport": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture current visible viewport"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Screenshot Stitcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
